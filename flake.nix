{
  description = "denpacord anti-spam bot";

  inputs = {
    # mandatory
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    # nix boilerplate
    flake-parts.url = "github:hercules-ci/flake-parts";
    # code formatter collection
    treefmt-nix.url = "github:numtide/treefmt-nix";
  };

  outputs =
    inputs@{
      self,
      nixpkgs,
      flake-parts,
      treefmt-nix,
    }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      # allows treefmt-nix options to be available within the flake
      imports = [
        inputs.treefmt-nix.flakeModule
      ];
      # allowed systems to pass to flake-parts
      systems = [
        "aarch64-darwin"
        "x86_64-darwin"
        "x86_64-linux"
      ];
      # flake outputs generated by flake-parts using nixpkgs
      perSystem =
        {
          lib,
          pkgs,
          system,
          ...
        }:
        {
          # the thing being built
          packages = rec {
            default = denpabot;
            denpabot = pkgs.callPackage ./nix/package.nix { };
          };

          # ephemeral development environments
          devShells = {
            default = pkgs.mkShell {
              strictDeps = true;
              nativeBuildInputs = with pkgs; [
                # build tools
                cargo
                rustc
                # dev tools
                clippy
                rustfmt
              ];
            };
          };

          # formatters to use via treefmt
          treefmt.programs = {
            # nix
            nixfmt.enable = true;
            # rust
            rustfmt.enable = true;
          };
        };
    };
}
